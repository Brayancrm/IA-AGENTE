    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "form-data": "^4.0.5",
    "pm2": "^5.3.0",
    "stripe": "^15.12.0"
  },
