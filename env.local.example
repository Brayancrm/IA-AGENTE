# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=sua-api-key-aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ia-agente-b2f46.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ia-agente-b2f46
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ia-agente-b2f46.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=seu-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=seu-app-id

# App Configuration
NEXT_PUBLIC_APP_ID=whatsapp-sales-agent

# Backend URL
# Para desenvolvimento local, use: http://localhost:3001
# Para produção, use a URL pública do seu backend (Railway, Render, VPS, etc.)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Exemplo para produção:
# NEXT_PUBLIC_BACKEND_URL=https://seu-backend.railway.app
# NEXT_PUBLIC_BACKEND_URL=https://seu-backend.render.com
# NEXT_PUBLIC_BACKEND_URL=https://seu-dominio.com:3001

# Unlayer Editor (Email Templates)
# Obtenha o Project ID em: https://unlayer.com (Developer Console)
NEXT_PUBLIC_UNLAYER_PROJECT_ID=seu_project_id_aqui
# API Key do Unlayer (opcional, mas recomendado para melhor autenticação)
# Obtenha em: https://unlayer.com → Developer Console → API Keys
NEXT_PUBLIC_UNLAYER_API_KEY=sua_api_key_aqui
